# ============================================================================
# Environment Variables — Cosmic Kicks
# ============================================================================

# --- PayPal (sandbox) ---
# Get from https://developer.paypal.com/dashboard/applications/sandbox
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is used by the checkout page to render buttons.
# If unset, the page falls back to the 'sb' sandbox demo client id.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET enable server-side order creation,
# capture, and accounting. If unset, the checkout falls back to client-side
# sandbox order creation/capture so the demo still works.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Optional: override the PayPal API base (defaults to sandbox).
# PAYPAL_API_BASE=https://api-m.paypal.com

# --- Stripe ---
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Get from https://dashboard.stripe.com/webhooks (create endpoint for localhost)
# For local dev: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- Supabase (accounting engine) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
